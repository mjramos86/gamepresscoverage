# Copy to .env (never commit it). In GitHub Actions, add these as repository secrets.

# Claude relevance filtering (optional; without it a keyword heuristic is used)
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5 at low effort. claude-haiku-5-5 is far cheaper for high volume.
COVERAGE_MODEL=claude-opus-5-5
# low | medium | high (low is plenty for triage)
COVERAGE_EFFORT=low

# YouTube Data API v3 key (console.cloud.google.com > APIs > YouTube Data API v3)
YOUTUBE_API_KEY=

# Twitch app (dev.twitch.tv/console) - client-credentials flow, no user login needed
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Reddit (optional - app-only OAuth is more reliable than the public JSON endpoint from cloud IPs)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gamepresscoverage/0.1 (by u/yourname)

# Bluesky (optional - search may require an authenticated session; use an App Password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Alerts: global fallbacks; per-project webhooks are referenced by env name in config/projects.json
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_SOLITAIRE_TOWER=

# Storage / server
DB_PATH=data/coverage.db
PORT=8787
# Optional: protect the dashboard's write endpoints (manual entry, overrides) with a token
DASHBOARD_TOKEN=
